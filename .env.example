# TravelSync Environment Variables Template
# Copy this file to .env and configure your keys

# --- AI Service (Python FastAPI) ---
AI_PORT=8000
AI_HOST=127.0.0.1

# Google Gemini API Key (Required for full LLM reasoning: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Amadeus Flight API Credentials (Optional - Mock flight fallback active if empty: https://developers.amadeus.com/)
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# StayingAPI Hotel Data API Key (Optional - Mock hotel fallback active if empty: https://stayingapi.com/)
# Use stay_test_... for deterministic sandbox or stay_live_... for live data
STAYINGAPI_KEY=your_stayingapi_key_here

# Database Configuration (PostgreSQL / SQLite default)
# PostgreSQL example: postgresql://postgres:password@localhost:5432/travelsync
# SQLite default: sqlite:///./travelsync.db
DATABASE_URL=sqlite:///./travelsync.db

# --- Backend Gateway (Node.js Express) ---
PORT=5000
NODE_ENV=development
AI_SERVICE_URL=http://127.0.0.1:8000
JWT_SECRET=travelsync_super_secret_jwt_key_academic_project_2026

# --- Frontend (React Vite) ---
VITE_API_BASE_URL=http://localhost:5000/api
